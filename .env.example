# ───────────────────────── Auth.js ─────────────────────────
# openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Google OAuth client (Google Cloud Console → APIs & Services → Credentials).
# Authorized redirect URIs must include BOTH:
#   http://localhost:3000/api/auth/callback/google   (sign-in)
#   http://localhost:3000/api/google/callback        (Workspace grant)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Optional. The Workspace callback defaults to AUTH_URL + /api/google/callback;
# set this only to override it.
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/google/callback

# ───────────────────────── Gemini ─────────────────────────
# REQUIREMENT 1: Gemini 3.5 or newer, via the Gemini API *or* Vertex AI.
# Leave GOOGLE_GENAI_USE_VERTEXAI unset (or "false") to use the Gemini API with an API key.
GEMINI_API_KEY=

# Set to "true" to route the same calls through Vertex AI instead. The GenAI SDK then
# uses Application Default Credentials (gcloud auth application-default login, or the
# Cloud Run service account) and ignores GEMINI_API_KEY.
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# One model per pipeline role, so any single leg can be retuned without a code change.
GEMINI_MODEL_WEB=gemini-3.5-flash
GEMINI_MODEL_MEMORY=gemini-3.5-flash
GEMINI_MODEL_SYNTH=gemini-3.5-flash
GEMINI_MODEL_WRITER=gemini-3.5-flash

# ───────────────────────── Database ─────────────────────────
# REQUIREMENT 3: Cloud SQL for PostgreSQL in production.
# Local dev (plain TCP):
DATABASE_URL=postgresql://postgres@localhost:5432/heykels?schema=public
#
# Cloud Run → Cloud SQL over the mounted unix socket. Set CLOUD_SQL_CONNECTION_NAME
# and lib/db.ts builds this URL for you:
#   postgresql://USER:PASS@localhost/heykels?host=/cloudsql/PROJECT:REGION:INSTANCE
CLOUD_SQL_CONNECTION_NAME=
DB_USER=
DB_PASSWORD=
DB_NAME=heykels

# ───────────────────────── App ─────────────────────────
# 32-byte key, base64. Encrypts Google refresh tokens at rest (AES-256-GCM).
# openssl rand -base64 32
APP_ENCRYPTION_KEY=
